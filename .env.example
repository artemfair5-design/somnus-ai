# Somnus AI — Environment Variables Template
# =============================================
# Скопируйте этот файл в .env и заполните значениями.
# Команда: copy .env.example .env  (в Windows CMD)
# Или:    cp .env.example .env     (в Git Bash)

# === База данных ===
# Для локальной разработки (SQLite):
DATABASE_URL="file:./db/custom.db"
#
# Для продакшена (Supabase PostgreSQL) — замените на:
# DATABASE_URL="postgresql://postgres.[ID]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# === Z.ai API (для AI-анализа снов) ===
# Получите на https://z.ai
ZAI_API_KEY="ваш_ключ_z_ai"
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# === NextAuth (для авторизации) ===
# Секрет для подписи JWT — сгенерируйте случайную строку.
# В Windows PowerShell: -join ((48..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
NEXTAUTH_SECRET="случайная_строка_минимум_32_символа"

# URL приложения:
# - Локально:     http://localhost:3000
# - На Vercel:    https://ваш-проект.vercel.app
NEXTAUTH_URL="http://localhost:3000"
